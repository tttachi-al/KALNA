# Copia este archivo como `.env` para cambiar el modo de datos.
#
# mock  -> usa el motor de demostración local (por defecto, no necesita backend)
# qvac  -> usa src/services/adapters/qvacAdapter.js y el backend de server/ (QVAC)
VITE_KALLPA_MODE=mock

# URL base del backend que expondrá los endpoints de KALLPA (solo modo qvac)
VITE_KALLPA_API_URL=http://localhost:8000/api

# Empleos Perú (MTPE): portal al que se envían las postulaciones recomendadas.
VITE_EMPLEOS_PERU_URL=https://www.empleosperu.gob.pe
# Opcional: plantilla con {q} para abrir directamente la búsqueda de un puesto.
# VITE_EMPLEOS_PERU_SEARCH_URL=https://…?q={q}

# ── Backend de KALLPA con QVAC (server/, `npm run server`, Node ≥ 22.17) ──
# Se leen solo en el servidor; nunca llegan al navegador.
# KALLPA_PORT=8000
# KALLPA_HOST=127.0.0.1
# KALLPA_CORS_ORIGIN=http://localhost:5173
# Constante de modelo de generación de texto exportada por @qvac/sdk 0.22.0.
# KALLPA_LLM_MODEL=QWEN3_4B_INST_Q4_K_M
# KALLPA_LLM_CTX=8192
# KALLPA_LLM_TIMEOUT_MS=60000

# ── PostgreSQL (conversaciones del chatbot) ──
# Solo la lee el servidor. Pon la URL real en `.env`, nunca en este archivo.
# Después ejecuta `npm run db:migrate` (el servidor también migra al arrancar).
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5432/kallpa
